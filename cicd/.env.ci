# =============================================================================
# .env.ci — Environment variables for docker-compose.ci.yml
# =============================================================================
# Throwaway dev credentials for ephemeral CI runners. NOT prod secrets.
# Safe to commit — these only live for the ~5 min lifespan of a test run.
# =============================================================================

# ---- Keys / JWT ----
