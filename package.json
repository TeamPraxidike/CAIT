{
	"name": "ml-teachers",
	"version": "0.0.1",
	"private": false,
	"scripts": {
		"setup": "npm install && npx prisma generate",
		"seed:test": "tsx ./scripts/seedTestData.ts",
		"dev": "chmod +x scripts/createSAMLidp.sh && scripts/dev.sh",
		"prebuild": "chmod +x scripts/dirname.sh && chmod +x scripts/createSAMLidp.sh && npx prisma generate && prisma migrate deploy",
		"build": "npm run prebuild && scripts/createSAMLidp.sh && vite build && scripts/dirname.sh",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest --coverage -c ./vitest.config.unit.ts",
		"test:integration": "scripts/run-integration.sh",
		"test:e2e": "scripts/run-e2e.sh",
		"test:e2e:report": "scripts/run-e2e.sh && playwright show-report",
		"test:e2e:generator": "npx playwright codegen localhost:5173/"
	},
	"engines": {
		"node": ">=26"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@esbuild-plugins/tsconfig-paths": "^0.1.2",
		"@eslint/js": "^9.39.4",
		"@iconify/svelte": "^4.2.0",
		"@iconify/tailwind": "^1.2.0",
		"@playwright/test": "^1.61.1",
		"@prisma/client": "^6.19.3",
		"@skeletonlabs/skeleton": "2.11.0",
		"@skeletonlabs/tw-plugin": "0.4.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/enhanced-img": "^0.3.10",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/eslint": "9.6.1",
		"@types/node": "^26.1.1",
		"@types/workerpool": "^9.0.0",
		"@typescript-eslint/eslint-plugin": "^8.63.0",
		"@typescript-eslint/parser": "^8.63.0",
		"@vitest/coverage-istanbul": "^3.2.7",
		"@vitest/coverage-v8": "^3.2.7",
		"autoprefixer": "10.5.2",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"postcss": "8.5.16",
		"prettier": "3.9.4",
		"prisma": "^6.19.3",
		"rollup-plugin-copy": "^3.5.0",
		"svelte": "^4.2.20",
		"svelte-check": "^4.7.2",
		"tailwindcss": "3.4.19",
		"tslib": "^2.8.1",
		"tsx": "^4.23.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.63.0",
		"vite": "5.4.21",
		"vite-plugin-static-copy": "^3.4.0",
		"vite-plugin-tailwind-purgecss": "0.3.5",
		"vitest": "^3.2.7"
	},
	"type": "module",
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"@huggingface/transformers": "^4.2.0",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.110.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@types/remove-markdown": "^0.3.4",
		"@types/word-extractor": "^1.0.6",
		"@xyflow/svelte": "^0.1.39",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"fuse.js": "^7.4.2",
		"highlight.js": "11.11.1",
		"html2canvas": "^1.4.1",
		"idb": "^8.0.3",
		"jszip": "^3.10.1",
		"natural": "^8.1.1",
		"office-text-extractor": "^4.0.0",
		"piscina": "^5.2.0",
		"postgres": "^3.4.9",
		"remove-markdown": "^0.6.4",
		"sharp": "^0.35.3",
		"supabase": "^2.109.1",
		"threads": "^1.7.0",
		"ts-node": "^10.9.2",
		"tus-js-client": "^4.3.1",
		"undici": "^8.7.0",
		"word-extractor": "^1.0.4",
		"workerpool": "^10.0.3"
	},
	"allowScripts": {
		"onnxruntime-node@1.24.3": true,
		"protobufjs@7.6.5": true,
		"sharp@0.34.5": true,
		"sharp@0.35.3": true,
		"@prisma/client@6.19.3": true,
		"@prisma/engines@6.19.3": true,
		"esbuild@0.28.1": true,
		"esbuild@0.21.5": true,
		"prisma@6.19.3": true
	}
}
